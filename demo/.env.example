# Copy to demo/.env and adjust if needed. These are demo credentials with obviously fake values.
# demo/up.py loads this automatically.

DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_GMS_TOKEN=demo-unset-token
WAREHOUSE_DSN=./demo/warehouse.duckdb

# Per-agent Airlock keys. In production these are real secrets; here they are demo placeholders.
AIRLOCK_KEY_GROWTH=demo-growth-key
AIRLOCK_KEY_FINANCE=demo-finance-key

# Secret salt for the equality-preserving hash mask. Use a long random value in production.
AIRLOCK_MASK_SALT=demo-not-secret-salt

